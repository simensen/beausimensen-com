---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Beau Simensen" description="The personal website of a professional polyglot programmer.">
  <main>
    <h1>Beau Simensen</h1>
    <p>The personal website of a professional polyglot programmer.</p>
    <nav>
      <a href="/posts/">Posts</a>
      <a href="/now/">Now</a>
    </nav>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 36rem;
    margin: 0 auto;
    padding: 6rem 1.5rem;
    text-align: center;
  }
  h1 {
    font-size: 2.5rem;
    font-weight: 500;
    margin: 0 0 1rem;
    letter-spacing: -0.015em;
  }
  p {
    margin: 0;
    color: #6b6b6b;
    font-size: 1.125rem;
    line-height: 1.6;
  }
  nav {
    margin-top: 2rem;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
  }
  nav a {
    color: var(--color-text);
    font-size: 1rem;
    text-underline-offset: 3px;
  }
</style>
